# Base URL of the Go API. Leave empty to call the same origin (the Vite dev
# proxy in development, or a reverse proxy in production).
# If set to another origin, the backend's CORS_ORIGIN must equal this app's origin.
VITE_API_BASE_URL=

# Where the Vite dev server proxies /v1 and /privacy (dev only).
# Leave empty to use HTTP_ADDR from ../go-housing-guest-book/.env (default :8080).
API_PROXY_TARGET=
